# --- NVIDIA Nemotron (build.nvidia.com / NIM) ---
# Get a key at https://build.nvidia.com/ -> any Nemotron model -> "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# --- LinkedIn (Marketing Developer Platform / w_member_social scope) ---
# Create app at https://www.linkedin.com/developers/ and complete OAuth to obtain a user access token.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXXXX

# --- X / Twitter API v2 (OAuth 1.0a user context, free tier supports POST /tweets) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Instagram Graph API (Business/Creator account linked to a Facebook Page) ---
# See https://developers.facebook.com/docs/instagram-api/getting-started
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- General ---
TIMEZONE=Europe/Helsinki
DRY_RUN=true
