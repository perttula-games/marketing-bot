# NVIDIA / Nemotron
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# X / Twitter
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Instagram Graph API
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_IMAGE_HOST_ALLOWLIST=

# General
TIMEZONE=Europe/Helsinki
DRY_RUN=true

# Telegram approval bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_IDS=
TELEGRAM_POLL_SECONDS=10