# NVIDIA / Nemotron
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# X / Twitter
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Instagram Graph API
IG_ACCESS_TOKEN=
IG_USER_ID=
# Comma-separated allowlist of hosts allowed to serve Instagram images
# (e.g. your S3 / R2 / Supabase storage). Subdomains of an allowed host
# are also accepted. Empty list => no image publishes are allowed.
IG_IMAGE_HOST_ALLOWLIST=

# Bluesky
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_SESSION_FILE=~/.nemo-bot/bluesky-session.json

# Discord
DISCORD_WEBHOOK_URL=

# General
TIMEZONE=Europe/Helsinki
DRY_RUN=true
MARKETING_SYSTEM_PROMPT_FILE=marketing-system-prompt.md

# Telegram approval bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_IDS=
TELEGRAM_APPROVER_USER_IDS=
TELEGRAM_POLL_SECONDS=10
